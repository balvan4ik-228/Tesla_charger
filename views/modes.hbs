<!doctype html>
<html lang="ru">
{{> head }}
<body>
<div class="screen">

  <main class="modes">
    <h1 class="page-title">Режимы езды</h1>

    <form class="filter" method="GET" action="/modes">
      <input class="filter-input"
             type="number"
             step="0.1"
             name="maxEnergy"
             placeholder="Расход не выше, кВт·ч/100 км"
             value="{{maxEnergy}}">
      <button class="filter-button" type="submit">Показать</button>
    </form>

    <div class="mode-grid">
      {{#each modes}}
        <a class="mode-card" href="/feed/{{id}}">
          <img class="mode-card-image" src="{{imageUrl}}" alt="{{modeName}}">
          <h2 class="mode-card-title">{{modeName}}</h2>
          <span class="mode-card-likes">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 20.5l-7.6-7a4.6 4.6 0 1 1 7.6-5 4.6 4.6 0 1 1 7.6 5z"/>
            </svg>
            {{likesCount}}
          </span>
        </a>
      {{else}}
        <p class="modes-empty">Режимов с таким расходом нет. Увеличьте значение фильтра.</p>
      {{/each}}
    </div>
  </main>

  {{> tabbar }}
</div>
</body>
</html>
