<!doctype html>
<html lang="ru">
{{> head }}
<body>
<div class="screen">

  <main class="feed">
    <video class="feed-video"
           src="{{mode.videoUrl}}"
           poster="{{mode.imageUrl}}"
           autoplay muted loop playsinline></video>

    <div class="feed-overlay">
      <h1 class="feed-title">{{mode.modeName}}</h1>

      <details class="feed-description">
        <summary>
          <span class="desc-preview">{{mode.shortDescription}}</span>
          <span class="desc-more">больше</span>
          <span class="desc-less">меньше</span>
        </summary>
        <p class="desc-full">{{mode.shortDescription}}</p>
      </details>

      <dl class="feed-params">
        <div class="feed-param">
          <dt>Средняя скорость</dt>
          <dd>{{mode.averageSpeedKmh}} км/ч</dd>
        </div>
        <div class="feed-param">
          <dt>Расход энергии</dt>
          <dd>{{mode.energyPer100Km}} кВт·ч/100 км</dd>
        </div>
      </dl>
    </div>

    <div class="feed-actions">
      <span class="like">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 20.5l-7.6-7a4.6 4.6 0 1 1 7.6-5 4.6 4.6 0 1 1 7.6 5z"/>
        </svg>
        <b>{{mode.likesCount}}</b>
      </span>
      <a class="next-button" href="/feed/{{mode.id}}?next=true">Следующий режим</a>
    </div>
  </main>

  {{> tabbar }}
</div>
</body>
</html>
