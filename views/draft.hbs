<!doctype html>
<html lang="ru">
{{> head }}
<body>
<div class="screen">

  <main class="draft">
    <h1 class="page-title">Новый режим езды</h1>

    <section class="field-group">
      <h2 class="group-title">Медиафайлы</h2>

      <label class="field">
        <span class="field-label">Изображение режима</span>
        <img class="field-image" src="{{mode.imageUrl}}" alt="{{mode.modeName}}">
      </label>

      <label class="field">
        <span class="field-label">Короткое видео</span>
        <video class="field-video"
               src="{{mode.videoUrl}}"
               poster="{{mode.imageUrl}}"
               autoplay muted loop playsinline></video>
      </label>
    </section>

    <section class="field-group">
      <h2 class="group-title">Описание</h2>

      <label class="field">
        <span class="field-label">Название режима</span>
        <input class="field-input" type="text" value="{{mode.modeName}}">
      </label>

      <label class="field">
        <span class="field-label">Краткое описание</span>
        <textarea class="field-input field-textarea" rows="5">{{mode.shortDescription}}</textarea>
      </label>
    </section>

    <section class="field-group">
      <h2 class="group-title">Параметры движения</h2>

      <label class="field">
        <span class="field-label">Средняя скорость, км/ч</span>
        <input class="field-input" type="number" value="{{mode.averageSpeedKmh}}">
      </label>

      <label class="field">
        <span class="field-label">Расход энергии, кВт·ч/100 км</span>
        <input class="field-input" type="number" step="0.1" value="{{mode.energyPer100Km}}">
      </label>
    </section>

    <p class="draft-status">Статус: {{mode.status}}</p>
  </main>

  {{> tabbar }}
</div>
</body>
</html>
