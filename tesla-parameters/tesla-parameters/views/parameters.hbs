<!doctype html>
<html lang="ru">
{{> head }}
<body>
<div class="screen">

  <main class="parameters">
    <h1 class="page-title">Параметры потребления</h1>

    {{!-- Двойной слайдер фильтрации по силе тока, фильтр применяется кнопкой --}}
    <form class="filter" method="GET" action="/parameters">
      <div class="filter-head">
        <span class="filter-title">Сила тока, А</span>
        <span class="filter-range">от {{minCurrent}} до {{maxCurrent}}</span>
      </div>

      <div class="slider-pair">
        <input class="slider" type="range" name="minCurrent"
               min="{{sliderMin}}" max="{{sliderMax}}" step="{{sliderStep}}"
               value="{{minCurrent}}" aria-label="Нижняя граница силы тока">
        <input class="slider" type="range" name="maxCurrent"
               min="{{sliderMin}}" max="{{sliderMax}}" step="{{sliderStep}}"
               value="{{maxCurrent}}" aria-label="Верхняя граница силы тока">
      </div>

      <div class="slider-scale">
        <span>{{sliderMin}}</span>
        <span>{{sliderMax}}</span>
      </div>

      <button class="wide-button" type="submit">Показать</button>
    </form>

    <div class="parameter-grid">
      {{#each parameters}}
        <div class="parameter-card">
          <a class="parameter-card-link" href="/parameter-feed/{{id}}">
            <img class="parameter-card-image" src="{{imageUrl}}" alt="{{parameterName}}">
            <h2 class="parameter-card-title">{{parameterName}}</h2>
            <span class="parameter-card-likes">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 20.5l-7.6-7a4.6 4.6 0 1 1 7.6-5 4.6 4.6 0 1 1 7.6 5z"/>
              </svg>
              {{likesCount}}
            </span>
          </a>
          <form class="parameter-card-delete" method="POST" action="/parameters/{{id}}/delete">
            <button type="submit" aria-label="Удалить параметр {{parameterName}}">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16 M9 7V4h6v3 M6 7l1 13h10l1-13"/>
              </svg>
            </button>
          </form>
        </div>
      {{else}}
        <p class="parameters-empty">В выбранном диапазоне силы тока параметров нет.</p>
      {{/each}}
    </div>
  </main>

  {{> tabbar }}
</div>
</body>
</html>
