<!doctype html>
<html lang="ru">
{{> head }}
<body>
<div class="screen">

  <main class="draft">
    <h1 class="page-title">Новый параметр</h1>

    {{#if parameter}}
      {{!-- Черновик создан: вводится только то, чего ещё нет --}}
      <section class="field-group">
        <img class="field-image" src="{{parameter.imageUrl}}" alt="{{parameter.parameterName}}">
        <video class="field-video"
               src="{{parameter.videoUrl}}"
               poster="{{parameter.imageUrl}}"
               autoplay muted loop playsinline></video>
        <p class="field-value">{{parameter.parameterName}}</p>
      </section>

      <form method="POST" action="/parameter-draft/publish">
        <section class="field-group">
          <label class="field">
            <span class="field-label">Краткое описание</span>
            <textarea class="field-input field-textarea"
                      name="shortDescription"
                      rows="4"
                      maxlength="1000"
                      required>{{parameter.shortDescription}}</textarea>
          </label>

          <label class="field">
            <span class="field-label">Потребляемая сила тока, А</span>
            <input class="field-input" type="number" name="currentA"
                   min="0.1" max="9999.9" step="0.1" value="{{parameter.currentA}}" required>
          </label>

          <label class="field">
            <span class="field-label">Потребляемая мощность, Вт</span>
            <input class="field-input" type="number" name="powerW"
                   min="1" step="1" value="{{parameter.powerW}}" required>
          </label>
        </section>

        <button class="wide-button" type="submit">Опубликовать</button>
      </form>

      <p class="draft-status">Статус: {{parameter.status}}</p>

    {{else}}
      {{!-- Черновика нет: выбор файлов из Minio и название --}}
      <form method="POST" action="/parameter-draft">
        <section class="field-group">
          <label class="field">
            <span class="field-label">Фото параметра</span>
            <select class="field-input" name="imageKey" required>
              <option value="" disabled selected>Выберите фото</option>
              {{#each imageKeys}}
                <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field">
            <span class="field-label">Видео параметра</span>
            <select class="field-input" name="videoKey" required>
              <option value="" disabled selected>Выберите видео</option>
              {{#each videoKeys}}
                <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field">
            <span class="field-label">Название параметра</span>
            <input class="field-input" type="text" name="parameterName"
                   maxlength="100" required>
          </label>
        </section>

        <button class="wide-button" type="submit">Далее</button>
      </form>
    {{/if}}
  </main>

  {{> tabbar }}
</div>
</body>
</html>
