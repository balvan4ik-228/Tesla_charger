<!doctype html>
<html lang="ru">
{{> head }}
<body>
<div class="screen">

  <main class="feed">
    <video class="feed-video"
           src="{{parameter.videoUrl}}"
           poster="{{parameter.imageUrl}}"
           autoplay muted loop playsinline></video>

    {{!-- Параметры по теме и обе иконки — справа поверх видео --}}
    <div class="feed-side">
      <div class="side-param">
        <span class="side-param-label">Сила тока</span>
        <span class="side-param-value">{{parameter.currentA}} А</span>
      </div>
      <div class="side-param">
        <span class="side-param-label">Мощность</span>
        <span class="side-param-value">{{parameter.powerW}} Вт</span>
      </div>

      <span class="side-like">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 20.5l-7.6-7a4.6 4.6 0 1 1 7.6-5 4.6 4.6 0 1 1 7.6 5z"/>
        </svg>
        <b>{{parameter.likesCount}}</b>
      </span>

      <a class="side-next" href="/parameter-feed/{{parameter.id}}?next=true"
         aria-label="Следующий параметр">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 6l6 6-6 6"/>
        </svg>
        <b>Далее</b>
      </a>
    </div>

    {{!-- Название и короткое описание — внизу --}}
    <div class="feed-overlay">
      <h1 class="feed-title">{{parameter.parameterName}}</h1>

      <details class="feed-description">
        <summary>
          <span class="desc-preview">{{parameter.shortDescription}}</span>
          <span class="desc-more">Ещё</span>
          <span class="desc-less">Свернуть</span>
        </summary>
        <p class="desc-full">{{parameter.shortDescription}}</p>
      </details>
    </div>
  </main>

  {{> tabbar }}
</div>
</body>
</html>
